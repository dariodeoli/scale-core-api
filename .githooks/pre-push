#!/usr/bin/env bash
# Bloquea pushes directos a main salvo que la sesión sea del integrador.
# Los agentes trabajan en ramas propias y nunca pushean a main; el integrador
# exporta MOBOS_INTEGRATOR=1 cuando corresponde (o usa el bypass consciente).
# Instalación: bash scripts/setup-hooks.sh (una vez por checkout/worktree).

set -euo pipefail

main_blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      if [[ "${MOBOS_INTEGRATOR:-}" != "1" ]]; then
        echo "✋ Push directo a main bloqueado por el hook pre-push." >&2
        echo "  Los agentes pushean a origin/<su-rama>. Solo el integrador toca main." >&2
        echo "  Si sos el integrador: MOBOS_INTEGRATOR=1 git push origin main" >&2
        main_blocked=1
      fi
      ;;
  esac
done

if [[ "$main_blocked" == "1" ]]; then
  exit 1
fi
exit 0
